<ls:UIWidget x:Name="COSConfigMenu"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ls="clr-namespace:ls;assembly=Code"
 ls:UIWidget.ContextName="GameMenu">
  <ls:UIWidget.Template><ControlTemplate><Grid>
    <Image Source="{StaticResource OptionsBackground}" Stretch="UniformToFill"/>
    <ls:LSInputBinding PlayerId="{Binding CurrentPlayer.PlayerId}" BoundEvent="UICancel"
      Command="{Binding CustomEvent}" CommandParameter="CloseWidget"/>
    <Grid Margin="180,90">
      <Grid.RowDefinitions><RowDefinition Height="{StaticResource PageHeaderHeight}"/><RowDefinition/><RowDefinition Height="150"/></Grid.RowDefinitions>
      <Control Grid.Row="0" Template="{StaticResource PageHeader}"
        Tag="{Binding Source='hc05fd001g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"/>
      <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
        FontSize="{StaticResource ScaledLargeFontSize}" Foreground="{StaticResource LS_baseTxtColor}"
        TextWrapping="Wrap" TextAlignment="Center"
        Text="{Binding Source='hc05fd002g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"/>
      <ls:LSButton Grid.Row="2" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center"
        Style="{StaticResource BigBrownButtonStyle}"
        Content="{Binding Source='hc05fd010g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"
        Command="{Binding CustomEvent}" CommandParameter="CloseWidget"/>
    </Grid>
  </Grid></ControlTemplate></ls:UIWidget.Template>
</ls:UIWidget>
