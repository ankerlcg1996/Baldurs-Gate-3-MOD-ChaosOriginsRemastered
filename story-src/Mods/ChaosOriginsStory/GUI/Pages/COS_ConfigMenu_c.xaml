<ls:UIWidget x:Name="COS_ConfigMenu_c"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ls="clr-namespace:ls;assembly=Code"
 ls:UIWidget.ContextName="GameMenu" ls:UIWidget.Focusable="False"
 FocusDown="UIDown" FocusUp="UIUp" ls:MoveFocus.FocusMovementMode="MainAxisTunnel">
  <ls:UIWidget.Template><ControlTemplate><Grid>
    <Image Source="{StaticResource OptionsBackground}" Stretch="UniformToFill"/>
    <ls:LSInputBinding PlayerId="{Binding CurrentPlayer.PlayerId}" BoundEvent="UICancel"
      Command="{Binding CustomEvent}" CommandParameter="CloseWidget"/>
    <Grid Margin="180,90">
      <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
        FontSize="{DynamicResource ScaledLargeFontSize}" Foreground="{StaticResource LS_baseTxtColor}"
        Text="{Binding Source='hc05fd001g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"/>
      <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
        FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_baseTxtColor}"
        TextWrapping="Wrap" TextAlignment="Center"
        Text="{Binding Source='hc05fd002g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"/>
      <ls:LSButton Grid.Row="2" Width="720" HorizontalAlignment="Center" VerticalAlignment="Center"
        Style="{StaticResource BigBrownButtonStyle}" ls:MoveFocus.Focusable="True" Focusable="True"
        Content="{Binding Source='hc05fd010g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"
        Command="{Binding CustomEvent}" CommandParameter="CloseWidget"/>
    </Grid>
  </Grid></ControlTemplate></ls:UIWidget.Template>
</ls:UIWidget>
