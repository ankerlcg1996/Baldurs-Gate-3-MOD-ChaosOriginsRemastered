<ls:UIWidget x:Name="COS_ConfigEscButton_c"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:ls="clr-namespace:ls;assembly=Code"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 mc:Ignorable="d" ls:UIWidget.ContextName="GameMenu"
 d:DesignWidth="3840" d:DesignHeight="2160">
  <ls:UIWidget.Template><ControlTemplate><Grid>
    <ls:LSButton x:Name="COSConfigEntryPrompt"
      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1740,0,0"
      Focusable="False" ContentTemplate="{StaticResource ControllerButtonHint}"
      Content="{Binding CurrentPlayer.UIData.InputEvents, Converter={StaticResource FindInputEventConverter}, ConverterParameter='UIShowInfo'}"
      Tag="{Binding Source='hc05fd001g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"
      BoundEvent="UIShowInfo" SoundID="UI_HUD_GameMenu_Options"
      TapTime="{StaticResource DefaultButtonTapTime}"
      Command="{Binding CustomEvent}" CommandParameter="OpenCOSConfig"/>
  </Grid></ControlTemplate></ls:UIWidget.Template>
</ls:UIWidget>
