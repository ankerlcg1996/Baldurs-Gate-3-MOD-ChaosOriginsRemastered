<ls:UIWidget x:Name="COSConfigEscButton"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:ls="clr-namespace:ls;assembly=Code"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 mc:Ignorable="d" ls:UIWidget.ContextName="GameMenu"
 d:DesignWidth="3840" d:DesignHeight="2160">
  <ls:UIWidget.Template><ControlTemplate><Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1700,0,0">
      <ls:LSButton Style="{StaticResource BigBrownButtonStyle}" Margin="0,0,0,8"
                   Visibility="Hidden" IsHitTestVisible="False" Focusable="False"/>
      <ls:LSButton x:Name="COSConfigEntryButton" Style="{StaticResource BigBrownButtonStyle}"
        Content="{Binding Source='hc05fd001g0000g4000g8000g000000000000', Converter={StaticResource TranslatedStringConverter}}"
        SoundID="UI_HUD_GameMenu_Options" Command="{Binding CustomEvent}"
        CommandParameter="OpenCOSConfig"/>
    </StackPanel>
  </Grid></ControlTemplate></ls:UIWidget.Template>
</ls:UIWidget>
